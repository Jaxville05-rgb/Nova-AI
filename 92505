*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
}

body{
    background-color: #0f172a;
    color:white
}
header{
    min-height: 100vh;
    background: linear-gradient(135deg,#0f172a,#1e293b,#2563eb);
}
.page-header{
    min-height: auto;
    background: #0f172a;
}
.nav-bar{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 25px 30px;
}
.nav-right{
    display: flex;
    align-items: center;
    gap: 30px;
}
.nav-links{
    display: flex;
    list-style: none;
    gap: 30px;
    padding-left: 40rem;
}                                                      

.logo{
    font-size: 30px;
    font-weight: bold;
    color: #38bdf8;
    padding-left: 6rem;
    padding-top: 1.5rem;
}

.nav-links a{
    color: white;
    text-decoration: none;
    transform: .3s;
}
.nav-links a:hover{
    color: #38bdf8;
}
.nav-btn{
    padding: 12px 24px;
    border: none;
    border-radius: 30px;
    background: #38bdf8;
    color: white;
    cursor: pointer;
    font-weight: bold;
}
.hero{
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 80vh;
    padding: 20px;
}
.hero h1{
    font-size: 60px;
    max-width: 850px;
    margin: auto;
}
.hero p{
    margin: 30px auto;
    max-width: 650px;
    font-size: 20px;
    color: #d1d5db;
}
.buttons{
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}
.primary,
.secondary{
    padding: 16px 35px;
    border: none;
    border-radius: 40px;
    cursor: pointer;
    font-size: 16px;
    transition: .3s;
}
.primary{
    background: #38bdf8;
    color: white;
}
.primary:hover{
    transform: translateY(-3px);
}
.secondary{
    background: transparent;
    color: white;
    border: 2px solid white;
}
.secondary:hover{
    background: white;
    color: #0f172a;
}
.features{
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(250px,1fr));
    gap: 25px;
    padding: 80px 8%;
    background: #111827;
}
.card{
    background: #1f2937;
    padding: 30px;
    border-radius: 15px;
    transition: .5s;
}
.card:hover{
    transform: translateY(-8px);
}
.card h3{
    margin-bottom: 15px;
}
footer{
    text-align: center;
    padding: 30px;
    background: #0f172a;
    color: #9ca3af;
}
@media(max-width:768px){
    .nav-bar{
        flex-direction: column;
        gap: 20px;
    }
    .nav-links{
        flex-wrap: wrap;
        justify-content: center;
    }
    .hero h1{
        font-size: 40px;
    }
    .hero p{
        font-size: 18px;
    }
}
/* =========================
   INNER PAGES
========================= */

.page-header {
    background: #0f172a;
}

.page-hero {
    text-align: center;
    padding: 100px 20px 60px;
}

.badge {
    display: inline-block;
    padding: 8px 15px;
    border-radius: 30px;
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 1px;
}

.page-hero h1 {
    font-size: 52px;
    max-width: 750px;
    margin: 20px auto;
}

.page-hero p {
    max-width: 600px;
    margin: auto;
    color: #cbd5e1;
    font-size: 18px;
    line-height: 1.7;
}


/* FEATURES */

.feature-grid {
    max-width: 1100px;
    margin: auto;
    padding: 50px 20px 100px;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.feature-card {
    background: #1e293b;
    padding: 35px;
    border-radius: 18px;
    border: 1px solid #334155;
    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-8px);
    border-color: #38bdf8;
}

.feature-icon {
    font-size: 35px;
    margin-bottom: 20px;
}

.feature-card h2 {
    margin-bottom: 12px;
}

.feature-card p {
    color: #94a3b8;
    line-height: 1.6;
}


/* PRICING */

.pricing-grid {
    max-width: 1100px;
    margin: auto;
    padding: 40px 20px 100px;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.price-card {
    position: relative;
    background: #1e293b;
    padding: 35px;
    border-radius: 20px;
    border: 1px solid #334155;
}

.price-card.featured {
    border: 2px solid #38bdf8;
    transform: scale(1.03);
}

.popular {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);

    background: #38bdf8;
    color: white;

    padding: 6px 15px;
    border-radius: 20px;

    font-size: 11px;
    font-weight: bold;
}

.price {
    font-size: 45px;
    font-weight: bold;
    margin: 20px 0;
}

.price span {
    font-size: 15px;
    color: #94a3b8;
}

.price-card > p:not(.price) {
    color: #94a3b8;
}

.price-card ul {
    list-style: none;
    margin: 30px 0;
}

.price-card li {
    margin: 15px 0;
    color: #cbd5e1;
}

.price-btn {
    display: block;
    text-align: center;

    padding: 14px;
    border-radius: 30px;

    background: #38bdf8;
    color: white;

    text-decoration: none;
    font-weight: bold;
}


/* CONTACT */

.contact-section {
    max-width: 650px;
    margin: auto;
    padding: 30px 20px 100px;
}

.contact-form {
    background: #1e293b;
    padding: 40px;
    border-radius: 20px;
    border: 1px solid #334155;

    display: flex;
    flex-direction: column;
    gap: 12px;
}

.contact-form label {
    margin-top: 10px;
    font-weight: bold;
}

.contact-form input,
.contact-form textarea {
    padding: 15px;
    border: 1px solid #475569;
    border-radius: 10px;
    background: #0f172a;
    color: white;
    outline: none;
}

.contact-form textarea {
    min-height: 150px;
    resize: vertical;
}

.contact-form input:focus,
.contact-form textarea:focus {
    border-color: #38bdf8;
}

.contact-form .primary {
    margin-top: 15px;
}


/* MOBILE */

@media (max-width: 800px) {

    .feature-grid,
    .pricing-grid {
        grid-template-columns: 1fr;
    }

    .price-card.featured {
        transform: none;
    }

    .page-hero h1 {
        font-size: 40px;
    }

    .nav-right {
        flex-direction: column;
    }

}
/* =========================
   HOME HERO
========================= */

.hero {
    min-height: 85vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 70px;
    padding: 70px 7%;
    text-align: left;
}

.hero-content {
    max-width: 650px;
}

.hero-badge {
    display: inline-block;
    padding: 8px 15px;
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 30px;
    background: rgba(56, 189, 248, 0.1);
    color: #38bdf8;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
}

.hero h1 {
    font-size: clamp(48px, 6vw, 78px);
    line-height: 1.05;
    margin: 25px 0;
    max-width: 700px;
}

.hero h1 span {
    color: #38bdf8;
}

.hero p {
    max-width: 570px;
    color: #cbd5e1;
    font-size: 19px;
    line-height: 1.7;
    margin-bottom: 30px;
}

.hero .buttons {
    justify-content: flex-start;
}

.hero .primary,
.hero .secondary {
    text-decoration: none;
    display: inline-block;
}

.hero-note {
    margin-top: 20px;
    color: #94a3b8;
    font-size: 13px;
}


/* =========================
   DASHBOARD MOCKUP
========================= */

.dashboard {
    width: 100%;
    max-width: 550px;
    margin-left: auto;

    padding: 25px;

    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.2);
    border-radius: 22px;

    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.4),
        0 0 60px rgba(56, 189, 248, 0.08);

    backdrop-filter: blur(15px);
}

.dashboard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.dashboard-label {
    font-size: 10px;
    color: #38bdf8;
    letter-spacing: 2px;
}

.dashboard-top h3 {
    margin-top: 5px;
}

.avatar {
    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background: #38bdf8;
    font-weight: bold;
}


.dashboard-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    margin-bottom: 15px;
}

.stat {
    padding: 20px;
    background: #1e293b;
    border-radius: 15px;
}

.stat span {
    display: block;
    color: #94a3b8;
    font-size: 12px;
    margin-bottom: 8px;
}

.stat strong {
    font-size: 25px;
    display: block;
}

.stat small {
    color: #38bdf8;
}


.ai-card {
    padding: 22px;
    background: linear-gradient(135deg,
            #1e293b,
            #172554);

    border-radius: 15px;
    margin-bottom: 15px;
}

.ai-title {
    display: flex;
    align-items: center;
    gap: 12px;
}

.ai-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;
    background: #38bdf8;
}

.ai-title small {
    display: block;
    color: #38bdf8;
    margin-top: 3px;
}

.ai-card p {
    font-size: 13px;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 15px 0;
}

.ai-card button {
    border: none;
    background: transparent;
    color: #38bdf8;
    cursor: pointer;
    font-weight: bold;
}


.activity {
    padding: 20px;
    background: #1e293b;
    border-radius: 15px;
}

.activity-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
}

.activity-header span {
    color: #38bdf8;
    font-size: 12px;
}

.activity-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid #334155;
}

.activity-icon {
    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 8px;
    background: #0f172a;
    color: #38bdf8;
}

.activity-item strong {
    display: block;
    font-size: 13px;
}

.activity-item small {
    color: #64748b;
    font-size: 11px;
}
@media (max-width: 900px) {

    .hero {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 60px 20px;
    }

    .hero-content {
        margin: auto;
    }

    .hero p {
        margin-left: auto;
        margin-right: auto;
    }

    .hero .buttons {
        justify-content: center;
    }

    .dashboard {
        margin: auto;
    }

}